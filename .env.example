APP_ENV=dev
LOG_LEVEL=info
SITE_URL=https://crdtrove.com/

CRDTROVE_LOGIN=your_login
CRDTROVE_PASSWORD=your_password

SESSION_STATE_PATH=./data/session-state.json
STATE_DB_PATH=./data/collector.db

PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

CHROMIUM_EXECUTABLE_PATH=

HEADLESS=true
DIAGNOSTIC_HEADFUL=false

POLL_INTERVAL_SEC=120
HEALTH_CHECK_INTERVAL_SEC=600
RECOVERY_MIN_BACKOFF_SEC=15
RECOVERY_MAX_BACKOFF_SEC=600
NAV_TIMEOUT_MS=45000

N8N_WEBHOOK_URL=
N8N_WEBHOOK_URL_DEV=
N8N_WEBHOOK_URL_PROD=
N8N_AUTH_HEADER_NAME=Authorization
N8N_AUTH_HEADER_VALUE=
N8N_TIMEOUT_MS=15000
N8N_RETRY_MAX_ATTEMPTS=5

HEALTH_ENDPOINT_ENABLED=true
HEALTH_ENDPOINT_HOST=127.0.0.1
HEALTH_ENDPOINT_PORT=8080

RESYNC_LOOKBACK_MESSAGES=30
COLLECTOR_VERSION=0.1.0
